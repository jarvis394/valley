# Shared by apps/web, apps/gallery and docker-compose.yml. Copy to .env.

# Postgres. Compose builds DATABASE_URL for its containers from the POSTGRES_* values.
POSTGRES_USER=valley
POSTGRES_PASSWORD=valley
POSTGRES_DB=valley
DATABASE_URL=postgres://valley:valley@localhost:5432/valley

# Public origin of the editor (apps/web). Used for auth cookies and links in emails.
PUBLIC_URL=http://localhost:3000
# 32+ random bytes (openssl rand -base64 32). Must be replaced in production.
BETTER_AUTH_SECRET=INSECURE_UPDATE_ME_IMMEDIATELY_DEV_ONLY
# Sign-up access once set up: invite (an admin approves each account) or open.
VALLEY_SIGNUP_MODE=invite
# Optional. Fixes the token in the /setup link a fresh instance prints to its log; 16+ characters.
VALLEY_SETUP_TOKEN=
# Optional locally: sends verification, password reset and approval emails via Resend.
# Unset logs email links to the server output.
RESEND_API_KEY=
# Replace with a sender on a domain verified in Resend before setting RESEND_API_KEY.
MAIL_FROM=Valley <noreply@valley.invalid>

MAX_UPLOAD_BYTES=2147483648

# Where files live: s3 (default), r2, local or immich.
STORAGE_DRIVER=s3
# Optional. Serves media straight from a public bucket or CDN instead of through the apps.
STORAGE_PUBLIC_URL=
# Optional. Keeps Valley's files under a folder of a shared bucket.
STORAGE_KEY_PREFIX=

# s3: AWS S3 or any S3-compatible service. These match the SeaweedFS container in compose.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=valley
S3_ACCESS_KEY_ID=valley
S3_SECRET_ACCESS_KEY=valley-secret
S3_FORCE_PATH_STYLE=true

# r2: Cloudflare R2.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# eu or fedramp, for buckets created in a jurisdiction.
R2_JURISDICTION=

# local: a directory on disk.
LOCAL_STORAGE_ROOT=./storage

# immich: Immich's UPLOAD_LOCATION or an external library. Valley writes only to IMMICH_FOLDER.
IMMICH_ROOT=
IMMICH_FOLDER=valley

# Ports compose publishes.
WEB_PORT=3000
GALLERY_PORT=3001

# Public URL for the gallery service
GALLERY_SERVICE_URL=http://localhost:3001
