{
  "name": "valley",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "oxlint-plugin-valley"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "web:dev": "turbo run dev --filter=@valley/web",
    "gallery:dev": "turbo run dev --filter=@valley/gallery",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "turbo run typecheck && oxlint && oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
